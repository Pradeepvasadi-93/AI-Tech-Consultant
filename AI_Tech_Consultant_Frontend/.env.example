# Optional Task 1 key. Leave blank if KNOWLEDGE_API_KEY is not configured in Task 1.
VITE_TASK1_API_KEY=

# Task 2 endpoint paths are configurable because the complete Task 2 route file was not in the source bundle available for this frontend build.
VITE_TASK2_EMAILS_PATH=/emails
VITE_TASK2_PROCESS_PATH=/emails/process
VITE_TASK2_REVIEW_SUFFIX=/review
VITE_TASK2_FEEDBACK_SUFFIX=/feedback
VITE_TASK2_SEND_SUFFIX=/send
